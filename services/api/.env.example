# Genblaze API Service - Environment Variables
# Copy this file to .env and fill in the values

# Required: OpenRouter API Key for Genblaze
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Model to use (defaults to qwen/qwen3.6-flash if not set)
# Options: qwen/qwen3.6-flash, qwen/qwen3.7-plus, qwen/qwen3.6-plus:free
# Or any other OpenRouter model ID
# OPENROUTER_MODEL=qwen/qwen3.6-flash

# Optional: CORS origins (comma-separated)
# For production, specify your Vercel frontend URL
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=*
