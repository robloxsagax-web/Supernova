# Supernova Frontend - Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# SUPABASE (Required)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# =============================================================================
# FASTAPI BACKEND (Required for Script Generation)
# =============================================================================
# Local development: http://localhost:8000
# Production: https://your-fastapi-backend.railway.app (or Render URL)

# Primary environment variable (used by Next.js API routes)
FASTAPI_URL=http://localhost:8000

# Alternative (can be used by client-side code if needed)
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# API KEYS (Server-side only)
# =============================================================================
# These are used by Next.js API routes, NOT by the browser

# OpenRouter API Key (used by some features)
OPENROUTER_API_KEY=your_openrouter_api_key

# Groq API Key (used by Market Intelligence)
GROQ_API_KEY=your_groq_api_key
